# ============================================
# .deployignore 예시 파일
# ============================================
# 이 파일을 .deployignore로 복사해서 사용하세요:
# cp .deployignore.example .deployignore
#
# 운영 배포 시 제외할 파일/폴더를 지정합니다.
# 경로는 dev-backend 디렉토리 기준입니다.
# ============================================

# 개발 중인 새 기능
# routes/new-feature.js
# controllers/newFeatureController.js
# models/NewModel.js

# 실험적 코드
# experimental/

# 테스트 파일
# *test.js
# *.test.js
# test-data/

# 임시 파일
# tmp-*.js
# debug-*.js

# 특정 라우트 제외
# routes/admin-experimental.js

