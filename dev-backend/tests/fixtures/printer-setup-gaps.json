{
  "_note": "화면 utils/printerSetupGaps.ts 와 서버 utils/printerSetupGaps.js 가 같이 읽는 입력·기대값. 한쪽만 고치면 다른 쪽 테스트가 깨진다.",
  "cases": [
    { "name": "매장 28: Noodles 주방만 빠짐", "mode": "rawbt",
      "settings": { "printerMode": "rawbt", "kitchenPrinter": { "enabled": true, "address": "", "method": "rawbt" },
        "kitchenStationPrinters": { "23": { "address": "Counter", "method": "qztray", "stationName": "Kitchen" }, "24": { "address": "", "method": "qztray", "stationName": "Noodles" } } },
      "expect": [{ "kind": "station", "stationId": "24", "name": "Noodles" }] },
    { "name": "켜진 주방 목록 이름을 씀", "mode": "rawbt", "active": [{ "id": 24, "name": "Noodle Bar" }],
      "settings": { "kitchenPrinter": { "enabled": true, "method": "rawbt" }, "kitchenStationPrinters": { "23": { "address": "Counter", "method": "qztray" }, "24": { "address": "", "method": "qztray", "stationName": "Noodles" } } },
      "expect": [{ "kind": "station", "stationId": "24", "name": "Noodle Bar" }] },
    { "name": "꺼진(목록에 없는) 주방은 안 봄", "mode": "rawbt", "active": [{ "id": 23, "name": "Kitchen" }],
      "settings": { "kitchenPrinter": { "enabled": true, "method": "rawbt" }, "kitchenStationPrinters": { "23": { "address": "Counter", "method": "qztray" }, "24": { "address": "", "method": "qztray" } } },
      "expect": [] },
    { "name": "주방 기본 주소가 있으면 그리로 나감", "mode": "rawbt",
      "settings": { "kitchenPrinter": { "enabled": true, "address": "192.168.0.50", "method": "qztray" }, "kitchenStationPrinters": { "24": { "address": "", "method": "qztray" } } },
      "expect": [] },
    { "name": "RawBT·브라우저는 주소 없이 나감", "mode": "rawbt",
      "settings": { "kitchenPrinter": { "enabled": true, "method": "rawbt" }, "kitchenStationPrinters": { "1": { "address": "", "method": "rawbt" }, "2": { "address": "", "method": "browser" } } },
      "expect": [] },
    { "name": "주방칸 방식 비면 printerMode(qztray) 따라 빠짐", "mode": "qztray",
      "settings": { "kitchenPrinter": { "enabled": true }, "kitchenStationPrinters": { "7": { "address": "", "stationName": "Bar" } } },
      "expect": [{ "kind": "station", "stationId": "7", "name": "Bar" }] },
    { "name": "모르는 printerMode 는 rawbt", "mode": "weird",
      "settings": { "kitchenPrinter": { "enabled": true }, "kitchenStationPrinters": { "7": { "address": "", "stationName": "Bar" } } },
      "expect": [] },
    { "name": "주방칸 없음 + 주방 기본 qztray 빈칸", "mode": "rawbt",
      "settings": { "kitchenPrinter": { "enabled": true, "method": "qztray", "address": " " } },
      "expect": [{ "kind": "kitchen" }] },
    { "name": "주방 인쇄 꺼짐", "mode": "rawbt",
      "settings": { "kitchenPrinter": { "enabled": false }, "kitchenStationPrinters": { "24": { "address": "", "method": "qztray" } } },
      "expect": [] },
    { "name": "설정 없음", "mode": "rawbt", "settings": null, "expect": [] }
  ]
}
