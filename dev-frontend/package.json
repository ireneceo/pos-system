  "scripts": {
    "start": "react-scripts start",
    "build": "CACHE_DIR=node_modules/.cache; if [ -d \"$CACHE_DIR\" ] && [ \"$(stat -c '%U' \"$CACHE_DIR\" 2>/dev/null)\" = 'root' ]; then SUDO_PW=$(grep SUDO_PASSWORD /var/www/dev-backend/.env | cut -d= -f2); echo $SUDO_PW | sudo -S chown -R $(whoami):$(whoami) \"$CACHE_DIR\"; fi; rm -rf build 2>/dev/null || true; NODE_OPTIONS='--max-old-space-size=768' react-scripts build",
    "build:dev": "./deploy-dev.sh",
    "build:prod": "NODE_OPTIONS='--max-old-space-size=768' react-scripts build && ./deploy.sh",
    "deploy:dev": "./deploy-dev.sh",
    "deploy": "./deploy.sh",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-globals": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-window": "^1.8.8",
    "fs-extra": "^11.3.2"
  }
}
