{
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(sudo /var/www/deploy-production.sh:*)",
      "Bash(curl:*)",
      "Bash(git push:*)",
      "Bash(npm run build:dev:*)",
      "Bash(node:*)",
      "Bash(python3 -m json.tool)",
      "Bash(pm2 restart:*)",
      "Bash(python3 -c \"import sys,json; print\\(json.load\\(sys.stdin\\).get\\('status'\\)\\)\")",
      "Bash(ssh:*)",
      "Bash(ls -la /var/www/dev-frontend-build/static/js/main.*.js)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(xargs -I{} basename {})",
      "Bash(xargs -I{} curl -sI \"https://purplehere.com/uploads/products/{}\")",
      "Bash(ls -la /var/www/dev-frontend-build/static/js/*.js)",
      "Bash(pm2 list *)",
      "Bash(ls /var/www/dev-frontend-build/static/js/main.*.js)",
      "Bash(xargs -I{} curl -sI \"https://dev.purplehere.com/static/js/{}\")",
      "Bash(stat -c '%y %s' /var/www/dev-frontend-build/static/js/main.*.js)",
      "Bash(pm2 jlist *)",
      "Bash(xargs -n1 basename)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/var/www/.claude/hooks/safety-guard.sh"
          }
        ]
      }
    ]
  }
}
